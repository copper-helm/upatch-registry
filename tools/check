import datetime
import os
import pathlib
import re
import sys
import tomllib

ROOT = pathlib.Path(__file__).resolve().parent.parent
UPATCHES = ROOT / "upatches"
NAME = re.compile(r"^[a-z0-9][a-z0-9-]{0,29}$")
CVE_NAME = re.compile(r"^(cve-\d{4}-\d{4,})(-[a-z0-9-]+)?$")
ADVISORY = re.compile(r"^[A-Za-z0-9._:-]{1,255}$")
RELATIVE_PATH = re.compile(r"^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$")
SPDX_BPF = "// SPDX-License-Identifier: GPL-2.0 OR BSD-2-Clause"
LICENSE = "GPL-2.0 OR BSD-2-Clause"
BPF_LICENSE = re.compile(r'SEC\("license"\)\s*=\s*"Dual BSD/GPL"')
TABLES = {"package", "files", "upatches"}
CVE_CATEGORIES = {"kernel-cve", "app-cve"}
MEMBER_PATH_MAX = 99
VERSION_BUDGET = len("10.10.10")


def all_entries():
    if not UPATCHES.is_dir():
        return []
    return sorted(p.parent for p in UPATCHES.glob("*/*/Beefile"))


def named_entries(args):
    found = []
    for arg in args:
        entry = pathlib.Path(arg).resolve()
        if entry.parent.parent != UPATCHES or not (entry / "Beefile").is_file():
            sys.exit(f"check: {arg} is not an entry under {UPATCHES.relative_to(ROOT)}/<category>/")
        found.append(entry)
    return found


def check_links(entry, problems):
    for directory, subdirs, files in os.walk(entry, followlinks=False):
        for name in subdirs + files:
            path = pathlib.Path(directory, name)
            if path.is_symlink():
                problems.append(f"{path.relative_to(entry)} is a symbolic link")


def inside(entry, value, what, problems, must_exist):
    if not isinstance(value, str) or not RELATIVE_PATH.match(value) or ".." in value.split("/"):
        problems.append(f"{what} {value!r} must be a relative path inside the entry, without '..'")
        return False
    if must_exist:
        path = (entry / value).resolve()
        if not path.is_relative_to(entry) or not path.is_file():
            problems.append(f"{what} {value!r} is not a regular file inside the entry")
            return False
    return True


def check_source(entry, item, problems):
    source = item.get("source", "")
    if not inside(entry, source, "source", problems, True):
        return None
    if "/" in source or not source.endswith(".bpf.c"):
        problems.append(f"source {source!r} must be a .bpf.c file at the top of the entry")
        return None
    text = (entry / source).read_text(encoding="utf-8")
    if text.splitlines()[:1] != [SPDX_BPF]:
        problems.append(f"{source}: the first line must be '{SPDX_BPF}'")
    if not BPF_LICENSE.search(text):
        problems.append(f'{source}: declare char _license[] SEC("license") = "Dual BSD/GPL";')
    for key in ("load_target", "unload_target"):
        if key in item:
            inside(entry, item[key], key, problems, False)
    if "rodata" in item:
        problems.append(f"{source}: [[upatches.rodata]] runs a generator command at build time; this registry does not take one")
    return source[: -len(".bpf.c")]


def check_tree(upatch, tree, cve, problems):
    if tree.get("id") != upatch:
        problems.append(f"[upatches.tree] id must be '{upatch}', the source's base name")
    for key in ("load_artifact", "unload_artifact"):
        if key in tree:
            problems.append(f"[upatches.tree] {key}: leave it out so the tree publishes the package's own artifacts")
    fixes = tree.get("fixes")
    if fixes is None:
        if cve:
            problems.append(f"[upatches.tree] fixes must list {cve.upper()}")
        return
    if not isinstance(fixes, list) or not 1 <= len(fixes) <= 16:
        problems.append("[upatches.tree] fixes must be a list of 1 to 16 IDs")
        return
    if len(set(fixes)) != len(fixes):
        problems.append("[upatches.tree] fixes lists an ID twice")
    for advisory in fixes:
        if not isinstance(advisory, str) or not ADVISORY.match(advisory):
            problems.append(f"[upatches.tree] fixes holds a malformed ID: {advisory!r}")
    if cve and cve.upper() not in fixes:
        problems.append(f"[upatches.tree] fixes must list {cve.upper()}")


def check_readme(entry, cve, problems):
    readme = entry / "README.md"
    if not readme.is_file():
        problems.append("README.md is missing")
        return
    text = readme.read_text(encoding="utf-8")
    if cve and cve.upper() not in text:
        problems.append(f"README.md never names {cve.upper()}")
    if not re.search(r"^## Sources\s*$", text, re.MULTILINE):
        problems.append("README.md needs a '## Sources' section")


EVIDENCE = "evidence"
EVIDENCE_FILE = "evidence.toml"
EVIDENCE_TOP = {"schema", "summary", "environment", "matrix", "media", "logs"}
ENV_REQUIRED = {"date", "kernel", "architecture", "target"}
ENV_OPTIONAL = {"machine", "distribution", "shirudo"}
ARCHITECTURES = {"x86_64", "aarch64", "riscv64"}
STATES = ("before", "loaded", "after")
MEDIA_KINDS = {"video", "image"}
MEDIA_URL = re.compile(r"^(https://[A-Za-z0-9.-]+/|/media/)[A-Za-z0-9_./%-]+$")
LOG_NAME = re.compile(r"^[A-Za-z0-9_.-]+\.(log|txt)$")
LOG_MAX = 64 * 1024


def short_text(value, limit):
    return isinstance(value, str) and value.strip() != "" and len(value) <= limit


def check_evidence(entry, problems):
    folder = entry / EVIDENCE
    path = folder / EVIDENCE_FILE
    if not path.is_file():
        problems.append(f"{EVIDENCE}/{EVIDENCE_FILE} is missing: record how the upatch was tested")
        return
    try:
        ev = tomllib.loads(path.read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError as err:
        problems.append(f"{EVIDENCE}/{EVIDENCE_FILE}: {err}")
        return
    where = f"{EVIDENCE}/{EVIDENCE_FILE}"
    for key in sorted(set(ev) - EVIDENCE_TOP):
        problems.append(f"{where}: unknown key '{key}'")
    if ev.get("schema") != 1:
        problems.append(f"{where}: schema must be 1")
    if not short_text(ev.get("summary"), 400):
        problems.append(f"{where}: summary must be a sentence of at most 400 characters")

    env = ev.get("environment")
    if not isinstance(env, dict):
        problems.append(f"{where}: [environment] is missing")
    else:
        for key in sorted(ENV_REQUIRED - set(env)):
            problems.append(f"{where}: [environment] needs '{key}'")
        for key in sorted(set(env) - ENV_REQUIRED - ENV_OPTIONAL):
            problems.append(f"{where}: [environment] has unknown key '{key}'")
        if "date" in env and not isinstance(env["date"], datetime.date):
            problems.append(f"{where}: [environment] date must be a TOML date, such as 2026-11-24")
        if "architecture" in env and env["architecture"] not in ARCHITECTURES:
            problems.append(f"{where}: [environment] architecture must be one of {sorted(ARCHITECTURES)}")
        for key in (ENV_REQUIRED | ENV_OPTIONAL) - {"date", "architecture"}:
            if key in env and not short_text(env[key], 200):
                problems.append(f"{where}: [environment] {key} must be text of at most 200 characters")

    matrix = ev.get("matrix")
    if not isinstance(matrix, dict):
        problems.append(f"{where}: [matrix] is missing")
    else:
        columns = matrix.get("columns")
        rows = matrix.get("rows")
        if not isinstance(columns, list) or not 1 <= len(columns) <= 8 or not all(short_text(c, 80) for c in columns):
            problems.append(f"{where}: [matrix] columns must be 1 to 8 labels of at most 80 characters")
            columns = None
        if not isinstance(rows, list) or not rows:
            problems.append(f"{where}: [matrix] needs rows")
        else:
            seen = []
            for row in rows:
                state = row.get("state") if isinstance(row, dict) else None
                if state not in STATES:
                    problems.append(f"{where}: [matrix] row state must be one of {list(STATES)}")
                    continue
                if state in seen:
                    problems.append(f"{where}: [matrix] state '{state}' appears twice")
                seen.append(state)
                values = row.get("values")
                if columns and (not isinstance(values, list) or len(values) != len(columns)
                                or not all(short_text(v, 80) for v in values)):
                    problems.append(f"{where}: [matrix] row '{state}' needs one value of at most 80 characters per column")
            if "loaded" not in seen:
                problems.append(f"{where}: [matrix] needs a 'loaded' row")

    for item in ev.get("media", []):
        if not isinstance(item, dict) or item.get("kind") not in MEDIA_KINDS:
            problems.append(f"{where}: [[media]] kind must be one of {sorted(MEDIA_KINDS)}")
            continue
        if not isinstance(item.get("url"), str) or not MEDIA_URL.match(item["url"]):
            problems.append(f"{where}: [[media]] url must be an https URL or a /media/ path; media files are not committed")
        if not short_text(item.get("caption"), 200):
            problems.append(f"{where}: [[media]] needs a caption of at most 200 characters")

    listed = {EVIDENCE_FILE}
    for item in ev.get("logs", []):
        name = item.get("file") if isinstance(item, dict) else None
        if not isinstance(name, str) or not LOG_NAME.match(name):
            problems.append(f"{where}: [[logs]] file must be a .log or .txt name inside {EVIDENCE}/")
            continue
        listed.add(name)
        log = folder / name
        if not log.is_file():
            problems.append(f"{EVIDENCE}/{name} is listed but missing")
            continue
        if log.stat().st_size > LOG_MAX:
            problems.append(f"{EVIDENCE}/{name} is larger than {LOG_MAX // 1024} KiB")
        try:
            log.read_bytes().decode("utf-8")
        except UnicodeDecodeError:
            problems.append(f"{EVIDENCE}/{name} is not UTF-8 text")
        if not short_text(item.get("caption"), 200):
            problems.append(f"{where}: [[logs]] needs a caption of at most 200 characters")

    for child in sorted(folder.iterdir()):
        if child.name not in listed:
            problems.append(f"{EVIDENCE}/{child.name} is not evidence.toml or a listed log; keep exploit code and payloads out")


def check_entry(entry):
    problems = []
    name = entry.name
    if not NAME.match(name):
        problems.append("the directory name must be 1 to 30 lowercase letters, digits and hyphens")
    cve = None
    if entry.parent.name in CVE_CATEGORIES:
        match = CVE_NAME.match(name)
        if match:
            cve = match.group(1)
        else:
            problems.append(f"a {entry.parent.name} entry's name starts with its CVE id, such as cve-2026-12345-foo-block")
    links = []
    check_links(entry, links)
    if links:
        return problems + links
    try:
        beefile = tomllib.loads((entry / "Beefile").read_text(encoding="utf-8"))
    except tomllib.TOMLDecodeError as err:
        return problems + [f"Beefile: {err}"]
    for table in sorted(set(beefile) - TABLES):
        problems.append(f"Beefile: [{table}] is not a table this registry takes")
    package = beefile.get("package", {})
    if package.get("name") != name:
        problems.append(f"[package] name must be '{name}', the directory name")
    if not package.get("description"):
        problems.append("[package] needs a description")
    if package.get("license") != LICENSE:
        problems.append(f"[package] license must be '{LICENSE}'")
    for item in beefile.get("files", []):
        inside(entry, item.get("source"), "[[files]] source", problems, True)
        if "target" in item:
            inside(entry, item["target"], "[[files]] target", problems, False)
    upatches = beefile.get("upatches", [])
    if not upatches:
        problems.append("the Beefile names no [[upatches]]")
    for item in upatches:
        upatch = check_source(entry, item, problems)
        if upatch is None:
            continue
        member = f"{name}-{'v' * VERSION_BUDGET}/upatches/{upatch}.unload.upatch"
        if len(member) > MEMBER_PATH_MAX:
            problems.append(f"{upatch}: the package and upatch names are too long for a {VERSION_BUDGET}-character version")
        if "tree" in item:
            check_tree(upatch, item["tree"], cve, problems)
    check_readme(entry, cve, problems)
    check_evidence(entry, problems)
    return problems


def main():
    found = named_entries(sys.argv[1:]) if len(sys.argv) > 1 else all_entries()
    failed = 0
    for entry in found:
        for problem in check_entry(entry):
            print(f"{entry.relative_to(ROOT)}: {problem}")
            failed += 1
    print(f"{len(found)} entries checked, {failed} problems")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
